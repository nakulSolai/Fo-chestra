# Copy to .env locally. Never put credentials in the UI, chat, Git, or screenshots.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/claude-sonnet-5-5
# Optional stronger planner: anthropic/claude-opus-5-5
STAGEHAND_MODEL=anthropic/claude-haiku-5-5
PORT=4318
MAX_BROWSER_WORKERS=2
BROWSER_HEADLESS=true
# Optional installed Chrome/Edge executable; autodetected on Windows otherwise.
BROWSER_EXECUTABLE_PATH=
FO_MCP_URL=https://mcp.api.wajo.ai/fo
# OAuth is the documented default. Optional existing bearer token stays server-side.
FO_ACCESS_TOKEN=
# Set only after reviewing the exact proposed live action in the app.
FO_ENABLE_LIVE_ACTIONS=false
FO_SESSION_BUDGET_CENTS=5000
